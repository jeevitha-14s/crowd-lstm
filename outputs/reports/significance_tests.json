  "method_notes": {
    "unit_of_resampling": "fold (one held-out clip), not frame",
    "n_bootstrap": 10000,
    "alpha": 0.05,
    "deeprod_horizon_note": "DeepROD produces a single AUROC per fold with no horizon concept; the same value is compared at every horizon, so only the k=0 comparison is a like-for-like task match. The k=30/60/90 rows show what its single-frame lookahead scores against labels it was never designed to predict.",
    "power_caveat": "n=7-11 folds. These tests are severely underpowered: a non-significant result means the experiment cannot distinguish the methods, not that they are equivalent.",
    "why_not_delong": "Per-frame prediction scores were not saved by train_forecast_model.py, so a DeLong test on paired ROC curves is not computable without retraining every method."
  }
